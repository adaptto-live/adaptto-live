    "linkifyjs": "^4.3.3",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "set-interval-async": "^3.0.3",
    "slugify": "^1.6.9",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1",
    "vue-timeago3": "^2.3.2"
